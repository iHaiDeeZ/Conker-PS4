-add_subdirectory(src/tools/file_to_c)
+if (PS4)
+    # PS4: file_to_c runs at build time, so it's built for the build machine, not the console.
+    set(RT64_HOST_FILE_TO_C "${CMAKE_BINARY_DIR}/host-tools/file_to_c")
+    if (NOT EXISTS "${RT64_HOST_FILE_TO_C}")
+        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/host-tools")
+        execute_process(COMMAND c++ -std=c++17 -O2 "${PROJECT_SOURCE_DIR}/src/tools/file_to_c/file_to_c.cpp" -o "${RT64_HOST_FILE_TO_C}"
+            RESULT_VARIABLE file_to_c_result)
+        if (NOT file_to_c_result EQUAL 0)
+            message(FATAL_ERROR "couldn't build file_to_c for the build machine")
+        endif()
+    endif()
+    add_executable(file_to_c IMPORTED GLOBAL)
+    set_target_properties(file_to_c PROPERTIES IMPORTED_LOCATION "${RT64_HOST_FILE_TO_C}")
+else()
+    add_subdirectory(src/tools/file_to_c)
+endif()
