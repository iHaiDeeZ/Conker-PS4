+
+// What F5, F7 and F6 do, for menus (the PS4's quick menu).
+void conker::save_states::save() {
+    ask_to_save();
+}
+
+void conker::save_states::load() {
+    ask_to_load();
+}
+
+int conker::save_states::next_slot() {
+    current_slot = current_slot % slot_count + 1;
+    return current_slot;
+}
+
+int conker::save_states::slot() {
+    return current_slot;
+}
