 // TODO:
 // - Fix resource pools.
 
+#ifdef __PS4__
+#include <atomic>
+#include <chrono>
+#include <fstream>
+#include <mutex>
+#include <thread>
+
+PFN_vkGetInstanceProcAddr ps4_vk_get_instance_proc_addr(); // ps4/ps4_wsi.cpp
+extern "C" const char *ps4_data_dir(); // port/ps4_crashlog.cpp
+
+// The pipeline cache in a file (/data/Conker/pipelines.bin), as G-Diffuser keeps its own: RADV's
+// shader compiler needs up to seconds per RT64 pipeline on the PS4's CPU, and with the cache a
+// pipeline made in an earlier run is ready at once. Loaded with the device; written every 20 s
+// while new pipelines appear, and when the device goes.
+namespace {
+    std::mutex ps4CacheMutex;
+    VkDevice ps4CacheDevice = VK_NULL_HANDLE;
+    VkPipelineCache ps4Cache = VK_NULL_HANDLE;
+    std::atomic<uint32_t> ps4CacheMade{ 0 };
+    uint32_t ps4CacheSavedAt = 0;
+    std::atomic<bool> ps4CacheSaverStarted{ false };
+
+    std::string ps4CachePath() {
+        return std::string(ps4_data_dir()) + "/pipelines.bin";
+    }
+
+    // under ps4CacheMutex
+    void ps4SaveCacheLocked() {
+        const uint32_t made = ps4CacheMade.load();
+        if ((ps4Cache == VK_NULL_HANDLE) || (made == ps4CacheSavedAt)) {
+            return;
+        }
+
+        size_t size = 0;
+        if ((vkGetPipelineCacheData(ps4CacheDevice, ps4Cache, &size, nullptr) != VK_SUCCESS) || (size == 0)) {
+            return;
+        }
+
+        std::vector<char> data(size);
+        if (vkGetPipelineCacheData(ps4CacheDevice, ps4Cache, &size, data.data()) != VK_SUCCESS) {
+            return;
+        }
+
+        const std::string path = ps4CachePath(), part = path + ".part";
+        {
+            std::ofstream out(part, std::ios::binary | std::ios::trunc);
+            out.write(data.data(), std::streamsize(size));
+            if (!out.good()) {
+                return;
+            }
+        }
+
+        std::rename(part.c_str(), path.c_str());
+        ps4CacheSavedAt = made;
+        fprintf(stdout, "[plume] pipeline cache: %zu KiB written (%u pipelines made this run)\n", size / 1024, made);
+    }
+
+    void ps4OpenCache(VkDevice device) {
+        std::vector<char> data;
+        {
+            std::ifstream in(ps4CachePath(), std::ios::binary);
+            if (in) {
+                data.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+            }
+        }
+
+        VkPipelineCacheCreateInfo info = {};
+        info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+        info.initialDataSize = data.size();
+        info.pInitialData = data.empty() ? nullptr : data.data();
+        VkPipelineCache cache = VK_NULL_HANDLE;
+        if (vkCreatePipelineCache(device, &info, nullptr, &cache) != VK_SUCCESS) {
+            // another driver build's data: start again
+            info.initialDataSize = 0;
+            info.pInitialData = nullptr;
+            if (vkCreatePipelineCache(device, &info, nullptr, &cache) != VK_SUCCESS) {
+                cache = VK_NULL_HANDLE;
+            }
+        }
+
+        fprintf(stdout, "[plume] pipeline cache: %zu KiB loaded from %s\n", data.size() / 1024, ps4CachePath().c_str());
+        {
+            std::lock_guard lock(ps4CacheMutex);
+            ps4CacheDevice = device;
+            ps4Cache = cache;
+        }
+
+        if (!ps4CacheSaverStarted.exchange(true)) {
+            std::thread([]() {
+                for (;;) {
+                    std::this_thread::sleep_for(std::chrono::seconds(20));
+                    std::lock_guard lock(ps4CacheMutex);
+                    ps4SaveCacheLocked();
+                }
+            }).detach();
+        }
+    }
+
+    void ps4CloseCache() {
+        std::lock_guard lock(ps4CacheMutex);
+        ps4SaveCacheLocked();
+        if (ps4Cache != VK_NULL_HANDLE) {
+            vkDestroyPipelineCache(ps4CacheDevice, ps4Cache, nullptr);
+        }
+
+        ps4Cache = VK_NULL_HANDLE;
+        ps4CacheDevice = VK_NULL_HANDLE;
+    }
+}
+#endif
