diff --git a/ultramodern/src/threads.cpp b/ultramodern/src/threads.cpp
index 221ad3d..7c6c382 100644
--- a/ultramodern/src/threads.cpp
+++ b/ultramodern/src/threads.cpp
@@ -99,6 +99,40 @@ void ultramodern::set_native_thread_priority(ThreadPriority pri) {
     }
     // SetThreadPriority(GetCurrentThread(), nPriority);
 }
+#elif defined(__PS4__)
+#include <pthread.h>
+
+#include "ps4_platform.h"
+
+void ultramodern::set_native_thread_name(const std::string& name) {
+    // the kernel's own name for the thread, and the port's (crash and freeze reports)
+    pthread_setname_np(pthread_self(), name.c_str());
+    ps4_thread_name(name.c_str());
+}
+
+void ultramodern::set_native_thread_priority(ThreadPriority pri) {
+    // above RT64's helpers and the shader compiles (ps4_platform.h): the game's threads (High),
+    // the timer (VeryHigh) and the VI thread (Critical) keep their time
+    switch (pri) {
+        case ThreadPriority::Low:
+            ps4_thread_role(PS4_ROLE_LOW);
+            break;
+        case ThreadPriority::Normal:
+            ps4_thread_role(PS4_ROLE_NORMAL);
+            break;
+        case ThreadPriority::High:
+            ps4_thread_role(PS4_ROLE_HIGH);
+            break;
+        case ThreadPriority::VeryHigh:
+            ps4_thread_role(PS4_ROLE_HIGHER);
+            break;
+        case ThreadPriority::Critical:
+            ps4_thread_role(PS4_ROLE_HIGHEST);
+            break;
+        default:
+            break;
+    }
+}
 #elif defined(__linux__)
